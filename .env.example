# KisanRakshak — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in Supabase Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Stored as a Supabase Edge Function secret — never expose in frontend code.
# Set via: supabase secrets set GEMINI_API_KEY=your_key_here
GEMINI_API_KEY=

# ── Open-Meteo ────────────────────────────────────────────────────────────────
# Open-Meteo is a free API — no key required.
# No environment variable needed for Phase B integration.
